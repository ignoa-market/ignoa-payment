# Database
MYSQL_DATABASE=ignoa_payment
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Internal API (ignoa-api ↔ ignoa-payment, 양쪽 같은 값)
INTERNAL_API_KEY=
API_BASE_URL=http://localhost:38080

# Toss Payments (개발자센터 결제위젯 연동 시크릿 키 test_gsk_…)
TOSS_BASE_URL=https://api.tosspayments.com
TOSS_SECRET_KEY=

# AWS CloudFront (로컬은 비워 둠)
CLOUDFRONT_ORIGIN_VERIFY=

# Logging
APP_LOG_LEVEL=DEBUG
